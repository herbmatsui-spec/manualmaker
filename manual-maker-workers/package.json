{
  "name": "manual-maker-workers",
  "version": "2.0.0",
  "description": "Cloudflare Workers version of Manual Maker - Handwritten manual processing system",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "dev:static": "wrangler dev --config wrangler.static.toml",
    "build:static": "wrangler deploy --config wrangler.static.toml --dry-run",
    "deploy:static": "wrangler deploy --config wrangler.static.toml",
    "deploy": "wrangler deploy",
    "build": "wrangler deploy --dry-run --outdir dist-ci",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "cloudflare-workers",
    "handwritten-manual",
    "ocr",
    "gemini",
    "pdf-processing"
  ],
  "author": "",
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240117.0",
    "@types/node": "^22.20.3",
    "@vitest/coverage-v8": "^3.2.7",
    "typescript": "^5.3.0",
    "vitest": "^3.2.7",
    "wrangler": "^3.0.0"
  },
  "dependencies": {
    "@hono/zod-openapi": "^0.10.0",
    "hono": "^4.0.0",
    "pdfjs-dist": "6.3.289",
    "zod": "^3.22.0"
  }
}
