# Manual Processor Environment Variables
# Copy this file to .env and fill in your values

# Google AI / Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_API_KEY=your_google_api_key_here

# Google Cloud Vision API (optional, for OCR)
GOOGLE_CLOUD_PROJECT_ID=your_project_id
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service_account.json

# Vision API Settings
VISION_API=true
VISION_API_TIMEOUT=30
VISION_MAX_RESULTS=10

# Gemini Model Settings
GEMINI_MODEL_NAME=gemini-1.5-flash
GEMINI_TEMPERATURE=0.3
GEMINI_MAX_OUTPUT_TOKENS=2048

# Processing Settings
PDF_DPI=300
MAX_FILE_SIZE_MB=50
SUPPORTED_EXTENSIONS=.pdf

# Processor Type: gemini, local, hybrid
PROCESSOR_TYPE=gemini
FALLBACK_ENABLED=true

# USB Monitor Settings
USB_MONITOR_PATHS=E:\,F:\
USB_AUTO_DETECT=true
USB_POLL_INTERVAL=1.0

# Web Server Settings
WEB_HOST=127.0.0.1
WEB_PORT=8000
WEB_UPLOAD_MAX_MB=100

# File Paths
OUTPUT_DIRECTORY=./output
TEMP_DIRECTORY=./temp

# Language Settings
APP_LANGUAGE=ja

# TTS Settings
TTS_LANGUAGE_CODE=ja-JP
TTS_VOICE_NAME=ja-JP-Standard-A
TTS_SPEAKING_RATE=1.0
TTS_PITCH=0.0

# Security Settings (optional)
# ENCRYPTION_KEY=your_32_byte_key_here

# Prompt Settings
PROMPT_LAYOUT=horizontal
PROMPT_DOMAIN_TERMS=
PROMPT_HAS_DIAGRAMS=false
PROMPT_LOW_QUALITY_MODE=false
PROMPT_STRICT_MODE=true
